<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nav2_chauffeur_critic</name>
  <version>0.1.0</version>
  <description>Passenger-comfort critic plugin for the Nav2 MPPI controller.</description>
  <maintainer email="noreply@users.noreply.github.com">Nav2++ Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>nav2_mppi_controller</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>eigen</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_mppi_controller plugin="${prefix}/chauffeur_critic_plugin.xml" />
  </export>
</package>
