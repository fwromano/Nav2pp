{
  "name": "jeep",
  "extends": "vehicle",
  "required_roles": [
    "map",
    "odom",
    "tf",
    "tf_static",
    "cmd_vel",
    "dbw_cmd"
  ],
  "recommended_roles": [
    "goal_pose",
    "imu",
    "gps_fix"
  ],
  "required_sensor_roles": [
    "scan",
    "pointcloud"
  ],
  "resource_hints": {
    "odom": [
      "/odometry/filtered",
      "/vehicle/odometry",
      "/odom"
    ],
    "scan": [
      "/front_lidar/scan",
      "/scan"
    ],
    "imu": [
      "/imu/data",
      "/imu"
    ],
    "gps_fix": [
      "/gps/fix",
      "/fix"
    ],
    "cmd_vel": [
      "/cmd_vel",
      "/nav/cmd_vel"
    ],
    "dbw_cmd": [
      "/vehicle/dbw/command",
      "/dbw/command",
      "/vehicle/ackermann_cmd"
    ]
  },
  "expected_topic_types": {
    "dbw_cmd": [
      "ackermann_msgs/msg/AckermannDriveStamped",
      "geometry_msgs/msg/Twist"
    ]
  },
  "host_checks": [
    {
      "name": "nvidia_gpu",
      "command": [
        "nvidia-smi",
        "--query-gpu=name",
        "--format=csv,noheader"
      ],
      "nonempty_stdout": true,
      "required": true
    }
  ],
  "notes": [
    "Use ./nav2++ profile scaffold jeep on the Linux vehicle computer to generate a first draft from the live graph.",
    "Keep built-in nav2 validation separate if you also want to require navigate_to_pose."
  ]
}
